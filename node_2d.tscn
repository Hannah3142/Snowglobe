[sub_resource type="Shader" id="Shader_0hol4"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;
uniform sampler2D noise_tex : repeat_enable;

uniform vec4 water_tint : source_color = vec4(0.1, 0.55, 0.85, 0.5);
uniform vec4 highlight_color : source_color = vec4(0.7, 0.9, 1.0, 0.45);
uniform vec2 scroll_speed = vec2(0.05, 0.02);
uniform float distortion_strength : hint_range(0.0, 0.1) = 0.025;
uniform float ripple_scale = 0.004; // Smaller value = larger waves in world pixels

varying vec2 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;
}

void fragment() {
	// Use world position
	vec2 base_uv = world_pos * ripple_scale;
	
	// Two layers of scrolling noise
	vec2 uv1 = base_uv + (TIME * scroll_speed);
	vec2 uv2 = (base_uv * 1.4) - (TIME * scroll_speed * 0.7);
	
	float n1 = texture(noise_tex, uv1).r;
	float n2 = texture(noise_tex, uv2).r;
	
	// Distort the screen behind the water (put things you want to distort above the water so godot draws them first)
	vec2 noise_offset = vec2(n1 - 0.5, n2 - 0.5);
	vec2 distorted_screen_uv = SCREEN_UV + (noise_offset * distortion_strength);
	vec4 bg_color = texture(SCREEN_TEXTURE, distorted_screen_uv);
	
	vec4 water = mix(bg_color, water_tint, water_tint.a);
	float ripple = smoothstep(0.55, 0.72, (n1 + n2) * 0.5);
	water = mix(water, highlight_color, ripple * highlight_color.a);
	
	COLOR = water;
}"

